  "deliberately_absent": {
    "note": "These concepts exist in the source dataset but are OUTCOME fields. They are named here so agents know what NOT to plan around reconstructing, and so prereg can reference an endpoint concept by name without seeing values. Their definitions and all values live in pipeline/locked/test_partition_manifest.json.",
    "endpoint_concepts": [
