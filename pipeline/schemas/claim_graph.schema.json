{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "claim_graph.schema.json",
  "title": "Claim Graph",
  "description": "Structured literature claims as (subject) -> (effect) -> (context/population) triples. Produced by literature-mapper. Contains NO patient-level or outcome data.",
  "type": "object",
  "required": [
    "schema_version",
    "topic",
    "generated_utc",
    "search",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "topic": {
      "type": "string",
      "description": "Narrow topic this graph covers, e.g. 'STK11 co-mutation and immunotherapy response in NSCLC'"
    },
    "generated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "search": {
      "type": "object",
      "required": [
        "queries",
        "sources",
        "date_range"
      ],
      "additionalProperties": false,
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "enum": [
              "pubmed",
              "biorxiv",
              "medrxiv",
              "clinicaltrials.gov",
              "conference_abstract",
              "journal_site",
              "other"
            ]
          },
          "minItems": 1
        },
        "date_range": {
          "type": "object",
          "required": [
            "from_year",
            "to_year"
          ],
          "additionalProperties": false,
          "properties": {
            "from_year": {
              "type": "integer",
              "minimum": 1990
            },
            "to_year": {
              "type": "integer",
              "minimum": 1990
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "Canonicalised nodes referenced by claims. Lets gap-finder cluster synonyms.",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "type",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "gene",
              "variant",
              "pathway",
              "drug",
              "drug_class",
              "biomarker",
              "cell_state",
              "clinical_feature"
            ]
          },
          "name": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identifier": {
            "type": "object",
            "description": "External ontology identifier where one exists.",
            "additionalProperties": false,
            "properties": {
              "hgnc": {
                "type": "string"
              },
              "ncbi_gene": {
                "type": "string"
              },
              "chembl": {
                "type": "string"
              },
              "rxnorm": {
                "type": "string"
              },
              "oncotree": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/claim"
      }
    },
    "coverage_notes": {
      "type": "string",
      "description": "What the mapper looked for and did NOT find. Feeds gap-finder's population-gap analysis."
    }
  },
  "definitions": {
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "context",
        "evidence",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^C-[0-9]{3,}$"
        },
        "subject": {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "gene",
                "variant",
                "pathway",
                "drug",
                "drug_class",
                "biomarker",
                "cell_state",
                "clinical_feature",
                "gene_combination"
              ]
            },
            "name": {
              "type": "string"
            },
            "entity_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "state": {
              "enum": [
                "loss_of_function",
                "gain_of_function",
                "amplification",
                "deletion",
                "mutation_any",
                "overexpression",
                "underexpression",
                "wildtype",
                "exposure",
                "co_mutation",
                "not_applicable"
              ],
              "description": "The molecular/clinical state of the subject that the claim is about."
            }
          }
        },
        "predicate": {
          "type": "object",
          "required": [
            "effect",
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "effect": {
              "enum": [
                "increases",
                "decreases",
                "no_effect",
                "mixed",
                "associates_with",
                "confers_resistance",
                "confers_sensitivity"
              ]
            },
            "on": {
              "type": "string",
              "description": "The measured quantity, e.g. 'progression-free survival on anti-PD-1 monotherapy', 'CD8+ TIL density'."
            },
            "magnitude": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metric": {
                  "enum": [
                    "HR",
                    "OR",
                    "RR",
                    "median_months",
                    "percent",
                    "fold_change",
                    "difference_in_means",
                    "not_reported"
                  ]
                },
                "point_estimate": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ci_low": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ci_high": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "p_value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "direction_certainty": {
              "enum": [
                "reported_significant",
                "reported_nonsignificant",
                "trend_only",
                "qualitative"
              ]
            }
          }
        },
        "context": {
          "type": "object",
          "required": [
            "disease"
          ],
          "additionalProperties": false,
          "properties": {
            "disease": {
              "type": "string",
              "description": "e.g. 'non-small cell lung cancer, adenocarcinoma'"
            },
            "stage": {
              "type": [
                "string",
                "null"
              ]
            },
            "treatment": {
              "type": [
                "string",
                "null"
              ],
              "description": "Exposure the claim is conditioned on, e.g. 'pembrolizumab monotherapy'"
            },
            "line_of_therapy": {
              "enum": [
                "first",
                "second_plus",
                "any",
                "adjuvant",
                "neoadjuvant",
                "not_specified"
              ]
            },
            "population": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "n": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "geography": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ancestry_reported": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "ancestry_detail": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "age_range": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sex_distribution": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "smoking_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notable_exclusions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "model_system": {
              "enum": [
                "human_clinical",
                "human_ex_vivo",
                "mouse",
                "cell_line",
                "organoid",
                "in_silico",
                "mixed"
              ]
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "source_type",
            "citation",
            "year",
            "design",
            "verified"
          ],
          "additionalProperties": false,
          "properties": {
            "source_type": {
              "enum": [
                "pubmed",
                "biorxiv",
                "medrxiv",
                "clinicaltrials.gov",
                "conference_abstract",
                "journal_site",
                "other"
              ]
            },
            "citation": {
              "type": "object",
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "pmid": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "doi": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "nct_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "first_author": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "journal": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "year": {
              "type": "integer",
              "minimum": 1990
            },
            "design": {
              "enum": [
                "randomized_trial",
                "trial_secondary_analysis",
                "prospective_cohort",
                "retrospective_cohort",
                "case_control",
                "pooled_analysis",
                "meta_analysis",
                "preclinical",
                "review",
                "case_series",
                "unclear"
              ]
            },
            "supporting_quote": {
              "type": [
                "string",
                "null"
              ],
              "description": "Verbatim sentence from the source that supports the triple. Required for verified claims."
            },
            "verified": {
              "type": "boolean",
              "description": "True only if the citation identifier was retrieved and the quote read. Never assert true for a recalled citation."
            }
          }
        },
        "confidence": {
          "enum": [
            "high",
            "moderate",
            "low"
          ]
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-[0-9]{3,}$"
          },
          "description": "Other claim_ids this claim contradicts in direction or magnitude."
        },
        "mechanism_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "One-line causal story if the source proposes one. Not the mapper's own speculation."
        }
      }
    }
  }
}
